{
  "schemaVersion": 1,
  "lanes": {
    "staging-testnet": {
      "environment": "staging-console",
      "origin": "https://console.staging.seams.sh",
      "siteOrigin": "https://staging.seams.sh",
      "workerName": "seams-sdk-d1-console-staging",
      "platformSupportEmails": ["n6378056@gmail.com"],
      "placementRegion": "aws:ap-southeast-1",
      "database": {
        "name": "seams-console-staging-sin",
        "id": "fbd3cfdc-125b-423d-b3c9-07aa2ff43688"
      },
      "emailDelivery": {
        "kind": "capture"
      },
      "billing": {
        "enabled": true,
        "secrets": ["STRIPE_API_SK"]
      }
    },
    "production-mainnet": {
      "environment": "production-console",
      "origin": "https://console.seams.sh",
      "siteOrigin": "https://seams.sh",
      "workerName": "seams-sdk-d1-console",
      "platformSupportEmails": ["n6378056@gmail.com"],
      "placementRegion": "aws:ap-southeast-1",
      "database": {
        "name": "seams-console",
        "id": "f6e040fb-5d39-4120-804b-92d60e5b5818"
      },
      "walletLanes": [
        { "lane": "production-mainnet", "environmentKeys": ["prod"] },
        { "lane": "production-testnet", "environmentKeys": ["dev", "staging"] }
      ],
      "emailDelivery": {
        "kind": "resend",
        "fromAddress": "info@purin.io"
      },
      "billing": {
        "enabled": true,
        "secrets": ["STRIPE_API_SK"]
      }
    }
  },
  "frontends": {
    "staging": {
      "branch": "dev",
      "walletConsoleOrigin": "https://console.staging.seams.sh",
      "formerWalletConsoleOrigins": [
        "https://account.staging.seams.sh",
        "https://staging.console.seams.sh",
        "https://console.staging.wallet.seams.sh"
      ],
      "walletConsolePagesProjectEnv": "CF_PAGES_PROJECT_WALLET_CONSOLE"
    },
    "production": {
      "branch": "main",
      "walletConsoleOrigin": "https://console.seams.sh",
      "formerWalletConsoleOrigins": ["https://account.seams.sh", "https://console.wallet.seams.sh"],
      "walletConsolePagesProjectEnv": "CF_PAGES_PROJECT_WALLET_CONSOLE"
    }
  }
}
